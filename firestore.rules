
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and permissions

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isActivePlus(userId) {
      return exists(/databases/$(database)/documents/memberProfiles/$(userId))
        && get(/databases/$(database)/documents/memberProfiles/$(userId)).data.package == "Plus"
        && get(/databases/$(database)/documents/memberProfiles/$(userId)).data.packageStatus == "active";
    }
function isActiveMember(userId) {
  return exists(/databases/$(database)/documents/memberProfiles/$(userId))
    && get(/databases/$(database)/documents/memberProfiles/$(userId)).data.packageStatus == "active"
    && get(/databases/$(database)/documents/memberProfiles/$(userId)).data.expiryDate is timestamp
    && request.time < get(/databases/$(database)/documents/memberProfiles/$(userId)).data.expiryDate;
}

    // Uganda agent regions and towns

    function validRegionTown(region, town) {
      return (
        region == "Central"
        && town in ["Kampala", "Mukono"]
      ) || (
        region == "Western"
        && town in ["Mbarara", "Fort Portal"]
      ) || (
        region == "Northern"
        && town in ["Gulu", "Lira"]
      ) || (
        region == "Eastern"
        && town in ["Jinja", "Mbale"]
      );
    }

    // Administrator records

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    
    // Member profiles

    match /memberProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.accountStatus == "pending"
        && request.resource.data.memberId is string
        && request.resource.data.memberId.matches('^HU[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly([
          "uid", "memberId", "name", "email",
          "accountStatus", "createdAt"
        ]);

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["name", "bio"])
        );

      allow delete: if false;
    }


    // Package activation requests

    match /activationRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.area is string
        && request.resource.data.packageRequested is string
        && request.resource.data.proposedPaymentMethod is string
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "uid", "area", "packageRequested",
          "proposedPaymentMethod", "status", "createdAt"
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "status", "reviewedAt", "reviewedBy"
          ]);

      allow delete: if false;
    }

    // Agent applications

match /agentApplications/{applicationId} {
  allow read: if isAdmin()
    || (
      signedIn()
      && resource.data.uid == request.auth.uid
    );

  allow create: if signedIn()
    && isActivePlus(request.auth.uid)
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.name is string
    && request.resource.data.email is string
    && request.resource.data.region is string
    && request.resource.data.town is string
    && validRegionTown(
      request.resource.data.region,
      request.resource.data.town
    )
    && request.resource.data.phone is string
    && request.resource.data.nin is string
    && request.resource.data.capitalDeclared is int
    && request.resource.data.capitalDeclared >= 50000
    && request.resource.data.bonusRate == 15
    && request.resource.data.estimatedBonus is int
    && request.resource.data.estimatedBonus
      >= request.resource.data.capitalDeclared * 15 / 100 - 0.5
    && request.resource.data.estimatedBonus
      <= request.resource.data.capitalDeclared * 15 / 100 + 0.5
    && request.resource.data.estimatedTotalFloat
      == request.resource.data.capitalDeclared
        + request.resource.data.estimatedBonus
    && request.resource.data.status == "pending"
    && request.resource.data.keys().hasOnly([
      "uid", "name", "email", "region", "town",
      "phone", "nin", "capitalDeclared",
      "bonusRate", "estimatedBonus", "estimatedTotalFloat",
      "status", "createdAt"
    ]);

  allow update: if isAdmin()
    && resource.data.status == "pending"
    && request.resource.data.diff(resource.data)
      .affectedKeys().hasOnly([
        "name", "status", "capitalVerified",
        "capitalVerifiedBy", "capitalVerifiedAt",
        "bonusRate", "bonusAmount", "totalRestrictedFloat",
        "reviewedAt", "reviewedBy"
      ]);

  allow delete: if false;
}

    // Public directory of approved agents

    match /agentDirectory/{agentId} {
      allow read: if resource.data.status == "approved";

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "uid", "name", "region", "town",
          "phone", "status", "approvedAt"
        ])
        && request.resource.data.uid == agentId
        && request.resource.data.status == "approved"
        && request.resource.data.region is string
        && request.resource.data.town is string
        && validRegionTown(
          request.resource.data.region,
          request.resource.data.town
        );

      allow delete: if isAdmin();
    }

    // Agent working float

match /agentFloats/{agentId} {
  allow read: if isAdmin();

  allow create: if isAdmin()
    && request.resource.data.uid == agentId
    && request.resource.data.currency == "UGX"
    && request.resource.data.capitalAmount is int
    && request.resource.data.capitalAmount >= 50000
    && request.resource.data.bonusRate == 15
    && request.resource.data.bonusAmount is int
    && request.resource.data.bonusAmount
      >= request.resource.data.capitalAmount * 15 / 100 - 0.5
    && request.resource.data.bonusAmount
      <= request.resource.data.capitalAmount * 15 / 100 + 0.5
    && request.resource.data.openingBalance
      == request.resource.data.capitalAmount
        + request.resource.data.bonusAmount
    && request.resource.data.restrictedBalance
      == request.resource.data.openingBalance
    && request.resource.data.withdrawableBalance == 0
    && request.resource.data.status == "active"
    && request.resource.data.restricted == true
    && request.resource.data.permittedUse == "member_package_activation"
    && request.resource.data.keys().hasOnly([
      "uid", "currency", "capitalAmount", "bonusRate",
      "bonusAmount", "openingBalance", "restrictedBalance",
      "withdrawableBalance", "status", "restricted",
      "permittedUse", "issuedAt", "issuedBy",
      "sourceApplicationId"
    ]);

  allow update, delete: if false;
}

// Agent float audit transactions

match /agentFloatTransactions/{transactionId} {
  allow read: if isAdmin();

  allow create: if isAdmin()
    && request.resource.data.type == "initial_float_issuance"
    && request.resource.data.currency == "UGX"
    && request.resource.data.capitalAmount is int
    && request.resource.data.capitalAmount >= 50000
    && request.resource.data.bonusRate == 15
    && request.resource.data.bonusAmount is int
    && request.resource.data.bonusAmount
      >= request.resource.data.capitalAmount * 15 / 100 - 0.5
    && request.resource.data.bonusAmount
      <= request.resource.data.capitalAmount * 15 / 100 + 0.5
    && request.resource.data.amount
      == request.resource.data.capitalAmount
        + request.resource.data.bonusAmount
    && request.resource.data.balanceAfter
      == request.resource.data.amount
    && request.resource.data.withdrawable == false
    && request.resource.data.keys().hasOnly([
      "uid", "type", "amount", "capitalAmount",
      "bonusRate", "bonusAmount", "currency",
      "balanceAfter", "withdrawable",
      "sourceApplicationId", "createdAt", "createdBy"
    ]);

  allow update, delete: if false;
}

    // Withdrawal requests

    
match /withdrawalRequests/{requestId} {
  allow read: if isAdmin()
    || (signedIn() && resource.data.uid == request.auth.uid);

  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.amount is number
    && request.resource.data.amount >= 2000
    && request.resource.data.amount == request.resource.data.amount
    && request.resource.data.fee is number
    && request.resource.data.fee >= 0
    && request.resource.data.fee <= request.resource.data.amount
    && request.resource.data.payout is number
    && request.resource.data.payout > 0
    && request.resource.data.payout
      == request.resource.data.amount - request.resource.data.fee
    && request.resource.data.currency == "UGX"
    && request.resource.data.method in [
      "Mobile Money", "Bank Transfer"
    ]
    && request.resource.data.accountName is string
    && request.resource.data.account is string
    && request.resource.data.accountName.size() > 0
    && request.resource.data.account.size() > 0
    && (
      (
        request.resource.data.method == "Mobile Money"
        && request.resource.data.accountNetwork in [
          "MTN", "Airtel", "Other"
        ]
      )
      ||
      (
        request.resource.data.method == "Bank Transfer"
        && request.resource.data.accountNetwork == ""
      )
    )
    && request.resource.data.status == "pending"
    && request.resource.data.keys().hasOnly([
      "uid", "amount", "fee", "payout", "totalDeducted",
      "currency", "method", "accountNetwork",
      "accountName", "account", "note", "status", "createdAt"
    ]);

  allow update: if isAdmin()
    && resource.data.status == "pending"
    && request.resource.data.diff(resource.data)
      .affectedKeys().hasOnly([
        "status", "reviewNote", "reviewedAt", "reviewedBy"
      ])
    && request.resource.data.status in ["approved", "rejected"];

  allow delete: if false;
}


    match /p2pTransfers/{transferId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /taskSubmissions/{submissionId} {
allow read: if isAdmin()
|| (signedIn() && resource.data.uid == request.auth.uid);

  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
&& isActiveMember(request.auth.uid)
    && request.resource.data.taskId is string
    && request.resource.data.taskId.size() <= 50
    && request.resource.data.taskTitle is string
    && request.resource.data.taskTitle.size() <= 150
    && request.resource.data.answer is string
    && request.resource.data.answer.size() > 0
    && request.resource.data.answer.size() <= 200
    && request.resource.data.status == "pending"
    && (
      !("notes" in request.resource.data)
      || (
        request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
      )
    )
    && request.resource.data.keys().hasOnly([
      "uid", "taskId", "taskTitle", "answer",
      "notes", "status", "createdAt"
    ]);

  allow update: if isAdmin()
    && resource.data.status == "pending"
    && request.resource.data.diff(resource.data)
      .affectedKeys().hasOnly([
        "status", "feedback", "isCorrect",
        "reviewedAt", "reviewedBy"
      ])
    && request.resource.data.status in ["approved", "rejected"]
    && (
      !("feedback" in request.resource.data)
      || (
        request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 500
      )
    );

  allow delete: if false;
}

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

       // HomeUtensils gift codes
    // Codes are single-use. Approval does not directly credit wallets.

    match /giftCodes/{giftCodeId} {
      // Administrators can view all gift codes.
      // Active members can look up an individual code only.
      allow get: if isAdmin()
        || (
          signedIn()
          && isActiveMember(request.auth.uid)
          && resource.data.code == giftCodeId
        );

      allow list: if isAdmin();

      // New code document IDs must equal the actual gift code.
      allow create: if isAdmin()
        && request.resource.data.code is string
        && giftCodeId == request.resource.data.code
        && request.resource.data.code.size() >= 8
        && request.resource.data.code.size() <= 40
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "code",
          "amount",
          "createdBy",
          "createdAt"
        ]);

      // Gift codes cannot be edited or deleted through the website.
      allow update, delete: if false;
    }

    match /giftCodeRedemptionRequests/{requestId} {
      // One request per gift code.
      // The request ID must equal the code, so a second claim
      // cannot create another request for the same code.
      allow create: if signedIn()
        && isActiveMember(request.auth.uid)
        && requestId == request.resource.data.code
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8
        && request.resource.data.code.size() <= 40
        && exists(
          /databases/$(database)/documents/giftCodes/$(requestId)
        )
        && get(
          /databases/$(database)/documents/giftCodes/$(requestId)
        ).data.code == requestId
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid",
          "code",
          "status",
          "createdAt"
        ]);

            // Administrators can read all claims.
      // Members can check whether a code is unclaimed.
      // Existing claims remain private to their owner and administrators.
      allow get: if isAdmin()
        || (
          signedIn()
          && !exists(
            /databases/$(database)/documents/giftCodeRedemptionRequests/$(requestId)
          )
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // Only administrators can list all claims.
      allow list: if isAdmin();

      // Only an administrator can review a pending claim.
      // Rejected claims remain recorded and cannot be resubmitted.
      allow update: if isAdmin()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "status",
            "reviewedAt",
            "reviewedBy",
            "reviewNote"
          ])
        && request.resource.data.status in [
          "approved",
          "rejected"
        ]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (
          !("reviewNote" in request.resource.data)
          || (
            request.resource.data.reviewNote is string
            && request.resource.data.reviewNote.size() <= 500
          )
        );

      // Claims cannot be deleted through the website.
      allow delete: if false;
    }
// Default: deny everything else

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
